# =============================================================================
# GinMovieAPI — Application Environment Configuration Template
# Copy this file to .env or app.env for local development and Docker Compose.
# =============================================================================

# Deployment Environment: development | production | test
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Service & Gateway Ports
# -----------------------------------------------------------------------------
SERVER_PORT=8081
GATEWAY_PORT=8080
HOST_GATEWAY_PORT=8080
HOST_MOVIE_PORT=8082
HOST_USER_PORT=8083

# -----------------------------------------------------------------------------
# Internal Microservice Routing (for API Gateway Reverse Proxy)
# In Docker Compose, use container hostnames:
# -----------------------------------------------------------------------------
MOVIE_SERVICE_URL=http://movie-service:8081
USER_SERVICE_URL=http://user-service:8082

# For local non-Docker development (go run), use:
# MOVIE_SERVICE_URL=http://localhost:8081
# USER_SERVICE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database Credentials & URIs
# -----------------------------------------------------------------------------
# PostgreSQL (User Service)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_pass_123
POSTGRES_DB=app_db
POSTGRES_PORT=5432
POSTGRES_URI=postgres://app_user:secure_pass_123@postgresdb:5432/app_db?sslmode=disable
# (For local non-Docker: postgres://app_user:secure_pass_123@localhost:5434/app_db?sslmode=disable)

# MongoDB (Movie Service)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password123
MONGO_PORT=27017
MONGO_URI=mongodb://admin:password123@mongodb:27017/?authSource=admin
# (For local non-Docker: mongodb://admin:password123@localhost:27018/?authSource=admin)

# Redis (Caching & Pub/Sub)
REDIS_PORT=6379
REDIS_URI=redisdb:6379
# (For local non-Docker: localhost:6379)

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# JWT Authentication Secret Key (MUST be identical across user-service and api-gateway)
SECERET_KEY=super-secret-jwt-signing-key-change-this-in-production-12345

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed browser origins (Frontend URLs)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080,https://moviehub.pages.dev

# -----------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect (Optional - for Google Single Sign-On)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/users/auth/google/callback
