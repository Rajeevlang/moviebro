# =============================================================================
# Frontend build-time environment (Vite bakes these into the bundle).
# Copy to .env for local dev, or set them in Cloudflare Pages:
# Settings -> Environment variables (applied at BUILD time, not runtime).
# =============================================================================

# Base URL of the API gateway. Local dev: leave empty (vite proxies /api
# to localhost:8080). Production on Cloudflare Pages: set to the public
# API URL hosted on EC2, e.g. https://api.yourdomain.com
VITE_API_BASE=

# Comma-separated emails allowed into the admin panel (UI gate only).
VITE_ADMIN_EMAILS=admin@cinedeck.dev
